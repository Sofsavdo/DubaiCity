# AI (ixtiyoriy). Kalit yo'q bo'lsa AI o'chiq turadi va ilova qoidaviy rejimda ishlaydi.
# Bu faylni .env ga nusxalab, kalitni FAQAT shu yerga yozing. .env git'ga qo'shilmaydi. Kalitni hech qachon chatga yozmang.

# anthropic | openai | gemini   (openai: OpenAI-mos istalgan xizmat, masalan Groq/OpenRouter, AI_BASE_URL bilan)
AI_PROVIDER=
AI_API_KEY=
# anthropic uchun standart: claude-haiku-5-5. openai va gemini uchun model nomini o'zingiz yozing.
AI_MODEL=
# Ixtiyoriy: boshqa manzil (masalan https://api.groq.com/openai  yoki OpenRouter)
AI_BASE_URL=
# Bir foydalanuvchiga kuniga AI so'rovlar soni
AI_DAILY_LIMIT=120
